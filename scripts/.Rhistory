pfcol = sapply(colors, function(c) adjustcolor(c, alpha.f = 0.5)),
plwd = 2,
cglcol = "grey",
cglty = 1,
axislabcol = "black",
caxislabels =  seq(min(min_values), max(max_values), by = 1))
# Aggiungi una legenda
legend("topright", legend = c("H-MEC", "C-MEC"), col = colors, pch = 15, pt.cex = 1.5)
dev.copy(svg,'Radar_Chart_MEC.svg', width = 10, height = 7)
dev.off()
