library(readxl)
merged_tabel <- read_excel("C:/Users/david/OneDrive - Università degli Studi di Parma/PhD/Projects/Coffee_leaf_infuses/data/processed/merged_tabel.xlsx")
View(merged_tabel)
head(merged_tabel)
# Rimuovi le colonne non numeriche (Sample e Group)
data_pca <- merged_tabel[, -c(1, 2)]
data_matrix <- as.matrix(data_pca)
data_scaled <- prep.autoscale(data_matrix, center = TRUE, scale = TRUE)
# Converte il gruppo in fattore
merged_tabel$group <- as.factor(merged_tabel$group)
# Esegui la PCA
pca_result <- PCA(data_scaled, scale.unit = TRUE, graph = FALSE)
# Grafico delle variabili principali (eigenvalues)
fviz_eig(pca_result,
addlabels = TRUE,
ggtheme = theme_bw(),
ylim = c(0, 70))
# PCA
fviz_pca_ind(pca_result,
geom.ind = "point",
label = "none",# Mostra i punti
pointshape = 21,
pointsize = 2, # Forma 21 per tutti i punti
fill.ind = merged_tabel$group,  # Colori diversi per gruppo
palette = c("#db312c", "#76C77F", "#1e33cc", "#1196aa", "#F695F1"),    # Tavolozza di colori
addEllipses = F, # Ellissi per i gruppi
legend.title = "Groups",
xlab = paste0("PC 1 (" , round(pca_result$eig[1,2], 2), "%)"),
ylab = paste("PC 2 (" , round(pca_result$eig[2,2], 2), "%)"),
ggtheme = theme_bw()) +
ggtitle("PCA - Cold") +
geom_text(aes(label = merged_tabel$group), vjust = -1)
"#F695F1", # rosa/lilla brillante
# Biplot
fviz_pca_biplot(pca_result,
geom.ind = "point",
label = "var",# Mostra solo le variabili
col.var = "contrib",
gradient.cols = c("grey","black"),
pointshape = 21,
pointsize = 3,
fill.ind = data_cold$group,        # Colora i punti in base ai gruppi
addEllipses = F,           # Aggiungi ellissi per i gruppi
ellipse.level = 0.95,          # Livello di confidenza per le ellissi             # Colore delle variabili
palette = c("#db312c", "#76C77F", "#1e33cc", "#1196aa", "#F695F1", "#FFBE3B", "#8A5FBF", "#00B2A9","#FF6F61","#4C4C4C" ),    # Colore delle osservazioni
repel = TRUE,                  # Evita la sovrapposizione delle etichet,
xlab = paste("PC 1 (" ,round(pca_result$eig[1,2], 2), "%)"),
ylab = paste("PC 2 (" , round(pca_result$eig[2,2], 2), "%)"),
ggtheme = theme_bw()) + ggtitle("Biplot") + labs(fill = "Groups",                        # Cambia il nome della legenda per i gruppi
color = "Contribution")  + ggtitle("PCA - Cold Infusions") + geom_text(aes(label = data_cold$group), vjust = -1)
# PCA
fviz_pca_ind(pca_result,
geom.ind = "point",
label = "none",# Mostra i punti
pointshape = 21,
pointsize = 2, # Forma 21 per tutti i punti
fill.ind = merged_tabel$group,  # Colori diversi per gruppo
palette = c("#db312c", "#76C77F", "#1e33cc", "#1196aa", "#F695F1", "#FFBE3B", "#8A5FBF", "#00B2A9","#FF6F61","#4C4C4C"),    # Tavolozza di colori
addEllipses = F, # Ellissi per i gruppi
legend.title = "Groups",
xlab = paste0("PC 1 (" , round(pca_result$eig[1,2], 2), "%)"),
ylab = paste("PC 2 (" , round(pca_result$eig[2,2], 2), "%)"),
ggtheme = theme_bw()) +
ggtitle("PCA - Cold") +
geom_text(aes(label = merged_tabel$group), vjust = -1)
# Contributo delle variabili
fviz_pca_var(pca_result,
col.var = "contrib",              # Colorare in base al contributo
gradient.cols = "YlOrRd",
legend.title = "Var. contribute",
repel = TRUE,                     # Evita la sovrapposizione delle etichette
xlab = paste0("PC 1 (" ,round(pca_result$eig[1,2], 2), "%)"),
ylab = paste("PC 2 (" , round(pca_result$eig[2,2], 2), "%)"),
ggtheme = theme_bw()) + ggtitle("Variables - PCA")
